#!/usr/bin/env bash
# wsctl — workspace control: sync a client workspace to target state (config + submodules).
# Client-only, native git, ephemeral read-only token, URL-scoped to github.com. Never rebuilds
# (that is a manual action). See `wsctl --help`. Built to the docker-health house style.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ROOT="$(cd "$DIR/../.." && pwd)"   # repo root = parent of .devcontainer/  (wsctl lives at .devcontainer/wsctl/)
export ROOT
# `--no-color` must take effect before lib.sh sets the color vars
for _a in "$@"; do [ "$_a" = "--no-color" ] && export COLOR=0; done
# shellcheck source=lib.sh
. "$DIR/lib.sh"

usage() { cat <<'EOF'
wsctl — workspace control
Sync a client workspace to target state: scaffold config, hold the read-only
token, and keep the submodules (.claude, devcontainers) current.
Runs the same on host or in-container. Never rebuilds — that's your call.

USAGE
  wsctl <command> [options]

COMMANDS
  setup     Scaffold config, capture the RO token, clone/register both submodules. Idempotent.
  update    Pull both submodules' current branch (git pull --ff-only). [submodule] optional.
  status    Read-only: each submodule's branch + dirty state. No network, no token.

OPTIONS
  -h, --help      Show this help
      --no-color  Plain output (auto when piped)
  setup --force   Overwrite scaffolded config from template
  setup --check   Report present/missing config + submodules; non-zero if incomplete

EXAMPLES
  wsctl setup
  wsctl status
  wsctl update
  wsctl update devcontainers
EOF
}

cmd_setup() {
  local pass="" a
  for a in "$@"; do case "$a" in
    --force|--check) pass="$pass $a" ;;
    -h|--help) info "usage: wsctl setup [--force] [--check]"; return 0 ;;
    *) die "setup: unknown arg '$a'" 2 ;;
  esac; done

  [ -f "$ROOT/.devcontainer/scaffold.sh" ] || die "scaffold.sh not found — copy the whole .devcontainer/ across first"
  # static config: reuse the proven scaffold.sh (SSOT — no 4th copy of the .mcp.json template)
  bash "$ROOT/.devcontainer/scaffold.sh" $pass
  case " $pass " in *" --check "*) return 0 ;; esac

  git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1 || die "$ROOT is not a git repository — run 'git init' (or clone) first"
  require_git_version

  local tok; tok="$(read_token)"
  if [ -z "$tok" ]; then
    printf 'Paste your READ-ONLY GitHub token (%s) — input hidden: ' "$TOKEN_VAR" >&2
    read -rs tok; echo >&2
    [ -n "$tok" ] || die "no token entered"
    persist_token "$tok"; ok "token saved to .env (0600)"
  else
    log "$TOKEN_VAR already set in .env"
  fi

  local rc=0 s
  info "→ ensuring submodules …"
  for s in $SUBMODULES; do
    if [ -e "$ROOT/$s/.git" ]; then
      log "  $s: present — leaving as-is (use 'wsctl update' to pull)"
    elif git_ro "$tok" -C "$ROOT" submodule add --force "$(url_for "$s")" "$s" >/dev/null 2>&1; then
      git config -f "$ROOT/.gitmodules" "submodule.$s.ignore" all >/dev/null 2>&1 || true
      ensure_on_branch "$s"
      ok "  $s: added (on $(current_branch "$s"))"
    else
      warn "  $s: clone FAILED — does $TOKEN_VAR have Contents:Read on $(url_for "$s") ?"; rc=1
    fi
  done

  echo >&2
  [ "$rc" = 0 ] || die "setup incomplete — a submodule could not be set up (see ⚠ above)"
  ok "onboarding ready — submodules in place."
  info "  next: set COMPOSE_PROJECT_NAME + DEVCONTAINER_INGRESS_PORT in .env, then Rebuild in Container."
}

cmd_update() {
  local only="" a
  for a in "$@"; do case "$a" in
    -h|--help) info "usage: wsctl update [submodule]"; return 0 ;;
    -*) die "update takes no flags ('--force' belongs to setup) — got '$a'" 2 ;;
    *) only="$a" ;;
  esac; done

  require_git_version
  local tok; tok="$(read_token)"
  [ -n "$tok" ] || die "$TOKEN_VAR is not set in $ROOT/.env.
    Add a READ-ONLY GitHub token (fine-grained PAT with Contents:Read on both
    Sevelantis/.claude and Sevelantis/devcontainers) as:  $TOKEN_VAR=<your token>
    in $ROOT/.env, then re-run — or run 'wsctl setup' to be prompted for it."

  local subs="$SUBMODULES"
  if [ -n "$only" ]; then
    valid_submodule "$only" || die "unknown submodule '$only' (expected: $SUBMODULES)" 2
    subs="$only"
  fi

  local rc=0 s br out
  for s in $subs; do
    [ -e "$ROOT/$s/.git" ] || { warn "$s: not cloned — run 'wsctl setup'"; rc=1; continue; }
    br="$(current_branch "$s")"
    [ "$br" = "(detached)" ] && { warn "$s: detached HEAD — checkout a branch first, then re-run"; rc=1; continue; }
    info "→ $s: pull $br"
    if out="$(git_ro "$tok" -C "$ROOT/$s" pull --ff-only 2>&1)"; then
      printf '%s\n' "$out" | sed 's/^/    /' >&2   # show git's own output: diffstat on a real pull, "Already up to date." otherwise
      ok "$s: on $br"
    else
      printf '%s\n' "$out" | sed 's/^/    /' >&2
      diagnose_pull "$s" "$out"; rc=1
    fi
  done
  return $rc
}

cmd_status() {
  info "submodule pins (git submodule status):"
  git -C "$ROOT" submodule status 2>/dev/null | sed 's/^/  /' >&2 || true
  local s dirty
  for s in $SUBMODULES; do
    if [ -e "$ROOT/$s/.git" ]; then
      dirty="$(git -C "$ROOT/$s" status --porcelain 2>/dev/null | grep -c . || true)"
      info "  $s: on $(current_branch "$s") · ${dirty:-0} uncommitted file(s)"
    else
      warn "  $s: not cloned"
    fi
  done
}

# --- dispatch ---
cmd=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --no-color) : ;;                                   # handled before sourcing lib.sh
    -h|--help)  if [ -z "$cmd" ]; then usage; exit 0; else args+=("$1"); fi ;;
    *)          if [ -z "$cmd" ]; then cmd="$1"; else args+=("$1"); fi ;;
  esac
  shift
done
[ -n "$cmd" ] || { usage >&2; exit 2; }   # usage-on-error → stderr; explicit --help → stdout (above)

case "$cmd" in
  setup)  cmd_setup  ${args[@]+"${args[@]}"} ;;
  update) cmd_update ${args[@]+"${args[@]}"} ;;
  status) cmd_status ${args[@]+"${args[@]}"} ;;
  *)      die "unknown command '$cmd' (try: wsctl --help)" 2 ;;
esac
